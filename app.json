{
  "expo": {
    "name": "GEFS",
    "slug": "gefs",
    "version": "3.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "gefs",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c4a6e"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0c4a6e"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.alessandroannini.gefs",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDOk-6HnjMttMkrD-WTiFgLahQb_lJxDGM"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GEFS to use your location for weather forecasts."
        }
      ],
      "expo-screen-orientation"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
